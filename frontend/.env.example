# HMS Web frontend configuration. Copy to `.env.local` and adjust.
# No production hostname is committed here or anywhere in src/.

# Where the frontend sends API calls.
# Leave as the relative default in development: vite.config.ts proxies
# /api/v1 to VITE_API_PROXY_TARGET, which avoids CORS entirely.
# In a deployed environment set this to the absolute API base, e.g.
#   VITE_API_BASE_URL=https://hms.example.internal/api/v1
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target: where FastAPI is listening locally.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
