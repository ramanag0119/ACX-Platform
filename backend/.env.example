# HMS Backend Environment Configuration

# --- BSS database: MySQL `inspironics_app` ---
# This is the ONLY HMS business database. There is no engine switch and no
# DATABASE_URL override: the legacy PostgreSQL `hms_db` has been retired and
# cannot be selected from configuration.
#
# The OSS database (`insp_iot`, PostgreSQL) is NOT configured here. It belongs
# to the OSS microservice in `oss-service/`, which owns its own settings and
# opens it read-only. HMS reaches OSS data over that service's API.
#
# THERE ARE NO MYSQL_HOST / PORT / DATABASE / USER / PASSWORD KEYS.
# Setting them here has NO EFFECT: `app/core/config.py` exposes all five as
# properties backed by the KeePass vault (`backend/etc/hmsBackend.kdbx`, entry
# `MYSQL_BSS`), and `extra="ignore"` means a stray key is silently dropped
# rather than overriding anything. Put the values on the vault entry instead:
#
#   URL field        -> host, e.g. 192.168.0.120
#   User name field  -> inspironics_app
#   Password field   -> the password
#   `Port` property  -> 3306
#   `Database`       -> inspironics_app
#   `SSL_CA_Path`    -> absolute path to the PEM CA bundle (see TLS below)
#
# Create or repair the vault with:
#   .venv\Scripts\python.exe etc\build_vault.py
# Verify it end to end with:
#   .venv\Scripts\python.exe -m scripts.verify_mysql_connection

# --- MySQL TLS ---
# The CA bundle path comes from the vault entry's `SSL_CA_Path` property, so it
# is rotated with the credential it protects. LEAVE THIS EMPTY unless this
# machine keeps its bundle somewhere else -- a value here overrides the vault.
# The bundle file itself must live OUTSIDE this repository.
MYSQL_SSL_CA=
# Verify the server certificate against that bundle. false encrypts without
# proving who is answering -- local work only, never a permanent workaround.
MYSQL_SSL_VERIFY_CERT=true
# Also require the certificate to name the host being connected to. On: the
# server certificate's SAN covers both the public identity
# (mysql.inspironicsindia.in / 183.82.242.65) and the LAN address HMS connects
# over (192.168.0.120). Set false only if a host is reached by a name or
# address the certificate does not carry -- that is a downgrade, not a fix.
MYSQL_SSL_VERIFY_IDENTITY=true

# --- Application ---
APP_NAME=HMS Backend
APP_ENV=development
DEBUG=true

# --- Authentication (Phase 2.4) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_in_every_environment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OSS microservice dispatch ---
# true: device/telemetry/alert/energy reads are forwarded to the OSS service,
# which reads the OSS database read-only. Rooms get their devices from
# room_device_map. false: those reads are served from the BSS database.
# Read at IMPORT time -- changing it requires a process restart.
OSS_ENABLED=false
OSS_SERVICE_URL=http://127.0.0.1:8001
# One URL per OSS microservice when each domain runs on its own port
# (ecosystem.config.js sets these for PM2). Unset ones use OSS_SERVICE_URL --
# which means telemetry/alert/energy would be asked of the DEVICE service and
# answer 404, so set all four when running uvicorn directly.
# OSS_DEVICE_SERVICE_URL=http://127.0.0.1:8001
# OSS_TELEMETRY_SERVICE_URL=http://127.0.0.1:8002
# OSS_ALERT_SERVICE_URL=http://127.0.0.1:8003
# OSS_ENERGY_SERVICE_URL=http://127.0.0.1:8004

# What happens when OSS cannot answer an OSS-surfaced read.
#   true  -- serve the stored BSS copy; the response carries
#            `X-HMS-Data-Source: stored` and the screen keeps working.
#   false -- strict: OSS data comes only through OSS APIs; 503 otherwise.
# Only consulted when OSS_ENABLED=true. Switch to false BEFORE removing the
# duplicated OSS tables from MySQL -- afterwards there is nothing to fall back
# to, and a silent 503 is worse than a planned one.
OSS_FALLBACK_TO_STORED=true
# Optional shared token; set the same value in oss-service/.env.
# OSS_SERVICE_TOKEN=
