# HMS Backend Environment Configuration

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hms_db
POSTGRES_SCHEMA=public

# Full SQLAlchemy URL (overrides the parts above when set)
# DATABASE_URL=postgresql+psycopg2://postgres:change_me@localhost:5432/hms_db

# --- Application ---
APP_NAME=HMS Backend
APP_ENV=development
DEBUG=true

# --- Authentication (Phase 2.4) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_in_every_environment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
