# HMS Backend Environment Configuration

# --- BSS database: MySQL `inspironics_app` ---
# This is the ONLY HMS business database. There is no engine switch and no
# DATABASE_URL override: the legacy PostgreSQL `hms_db` has been retired and
# cannot be selected from configuration.
#
# The OSS database (`insp_iot`, PostgreSQL) is NOT configured here. It belongs
# to the OSS microservice in `oss-service/`, which owns its own settings and
# opens it read-only. HMS reaches OSS data over that service's API.
MYSQL_HOST=192.168.0.120
MYSQL_PORT=3306
MYSQL_DATABASE=inspironics_app
MYSQL_USER=inspironics_app
# Leave EMPTY here. Supply the real password at run time from the KeePass
# vault:  secure-local\run_with_secret.py -- uvicorn app.main:app --reload
MYSQL_PASSWORD=

# --- MySQL TLS ---
# Absolute path to the PEM CA bundle that signed the MySQL server certificate.
# Required while MYSQL_SSL_VERIFY_CERT=true. Obtain it from the DBA; on the
# server it is the file named by `SHOW VARIABLES LIKE 'ssl_ca'`.
MYSQL_SSL_CA=
# false encrypts without verifying the server identity -- local work only,
# never a permanent workaround for a missing CA.
MYSQL_SSL_VERIFY_CERT=true
# The server presents MySQL's auto-generated certificate, whose CN is not a
# hostname and which carries no SAN, so identity verification cannot succeed.
MYSQL_SSL_VERIFY_IDENTITY=false

# --- Application ---
APP_NAME=HMS Backend
APP_ENV=development
DEBUG=true

# --- Authentication (Phase 2.4) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_in_every_environment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OSS microservice dispatch ---
# true: device/telemetry/alert/energy reads are forwarded to the OSS service,
# which reads the OSS database read-only. Rooms get their devices from
# room_device_map. false: those reads are served from the BSS database.
OSS_ENABLED=false
OSS_SERVICE_URL=http://127.0.0.1:8001
# One URL per OSS microservice when each domain runs on its own port
# (ecosystem.config.js sets these for PM2). Unset ones use OSS_SERVICE_URL.
# OSS_DEVICE_SERVICE_URL=http://127.0.0.1:8001
# OSS_TELEMETRY_SERVICE_URL=http://127.0.0.1:8002
# OSS_ALERT_SERVICE_URL=http://127.0.0.1:8003
# OSS_ENERGY_SERVICE_URL=http://127.0.0.1:8004
# Optional shared token; set the same value in oss-service/.env.
# OSS_SERVICE_TOKEN=
