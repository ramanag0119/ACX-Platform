# TypeScript incremental build artifacts
*.tsbuildinfo

# PostgreSQL dumps and database backups -- never commit. A pg_dump of hms_db
# carries real password hashes and guest PII, and it is not application
# source: the schema comes from `alembic upgrade head` and the data from
# `python -m seeds.run_seed`.
hms_db_full_backup.sql
*_backup.sql
*_dump.sql
*.dump

# --- Local credential vault -- NEVER commit ---
# secure-local/ holds the KeePass vault for the BSS MySQL credentials. The
# .kdbx is encrypted, but an encrypted vault in a public history is still an
# offline brute-force target, so the whole directory stays out of git.
# The vault's MASTER PASSWORD is never stored here, or anywhere in this repo.
secure-local/
*.kdbx
*.kdb
*.zip

# --- Credential vault (backend/etc) -- NEVER commit ---
# The KeePass vault and the ZIP holding its master password. Encrypted or
# not, these reach the production database; they stay on the machine.
# The glob is *.kdbx* so that --reset backups (*.kdbx.unopenable-N.bak) are
# covered too; they are still real vaults.
backend/etc/*.kdbx*
backend/etc/shibboleth.zip

# Ad-hoc mysqldump output taken from the production BSS host. Schema-only or
# not, a dump of 192.168.0.120 is not application source and does not belong
# in history. The committed schema reference is scripts/bss_mysql_schema.json,
# regenerated by `scripts/audit_bss_mysql.py`.
db_schema/

# Local test-database baselines: ~3 MB of regenerable mysqldump output
# rebuilt in seconds by `scripts/local_testdb.py snapshot`. Data dumps do not
# belong in history -- see the *_backup.sql / *_dump.sql rules above.
backend/.testdb-baselines/
