# HMS OSS service configuration. Copy to `.env` and fill in real values.
# NEVER commit `.env` (it is git-ignored). NEVER print the password.

APP_ENV=development
DEBUG=true

# Bind to a private interface (trusted-LAN PoC; no inter-service auth).
HOST=127.0.0.1
PORT=8001

# Domains this process serves (device, telemetry, alert, energy). Under PM2
# each domain is its own process and ecosystem.config.js sets this per app.
# OSS_DOMAINS=device,telemetry,alert,energy

# --- OSS database (the existing, externally-owned device DB) ---
# Provide the full URL, e.g.:
# OSS_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@192.168.x.120:5432/OSS_DB_NAME
#
# ...or the discrete parts (the URL wins if both are set):
# OSS_DB_HOST=192.168.x.120
# OSS_DB_PORT=5432
# OSS_DB_NAME=
# OSS_DB_USER=
# OSS_DB_PASSWORD=
#
# Until one of these is set, the service starts and serves /health, but data
# routes return 503 "OSS data layer not configured".
OSS_DATABASE_URL=
